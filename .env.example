# ============================================
# AnalyzPRO — Environment Variables
# ============================================

# Общие настройки
APP_ENV=development
LOG_LEVEL=info
USE_MOCK=false

# Telegram Bot
BOT_TOKEN=your_bot_token_here
LOADING_STICKER_ID=your_sticker_id
ADMIN_CHAT_ID=your_admin_chat_id

# AI Models — Gemini
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_MODEL=gemini-3.5-flash

# AI Models — DeepSeek (опционально)
DEEPSEEK_API_KEY=

# AI Models — Claude (опционально)
ANTHROPIC_API_KEY=

# Хранение данных
UPLOAD_DIR=./uploads
DATABASE_URL=postgres://postgres:postgres@localhost:5432/analyzpro?sslmode=disable

# PDF Generation
HTML2PDF_API_KEY=your_html2pdf_api_key_here

# Web App (Дашборд)
WEBAPP_URL=http://localhost:8080/dashboard
DASHBOARD_URL=http://localhost:8080/dashboard