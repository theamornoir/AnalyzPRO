# ============================================================
# AnalyzPRO — Environment Variables (EXAMPLE)
# Copy to .env and fill in real values:  cp .env.example .env
# ============================================================
#
# DEPLOY NOTES
#   • Production: set APP_ENV=production.
#   • Provide WEBAPP_URL / DASHBOARD_URL as REAL HTTPS URLs (Telegram
#     Mini Apps require HTTPS). On a server behind a reverse proxy / TLS
#     terminator point these at your public https://... addresses.
#   • Mount ./data as a PERSISTENT VOLUME (Docker volume or bind mount)
#     so analyses, premium users and state survive container restarts.
#   • Payments: YooKassa integration is still in MOCK MODE — no real
#     charges are made. Keep test/mock values until it is switched on.
#   • Only ONE instance may run (flock on /tmp/analyzpro.lock).
# ============================================================

# Общие настройки
APP_ENV=development
LOG_LEVEL=info
USE_MOCK=false
HTTP_ADDR=:8080

# Telegram Bot
BOT_TOKEN=your_bot_token_here
LOADING_STICKER_ID=your_sticker_id
ADMIN_CHAT_ID=your_admin_chat_id

# AI Models — Gemini (единственный провайдер ИИ; читает фото и PDF)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key
# Модель по умолчанию — gemini-2.5-flash (дешёвая, умеет vision+PDF).
# Можно переопределить без пересборки, напр. gemini-2.5-flash-lite (ещё дешевле).
GOOGLE_AI_MODEL=gemini-2.5-flash

# Egress-прокси ТОЛЬКО для AI-вызовов (Gemini). Решает гео-блок Gemini.
# Локальный SOCKS5-порт VPN/Clash: socks5://127.0.0.1:1080
# (либо http/https-прокси). Если пусто — используется системный HTTPS_PROXY.
GEMINI_PROXY=
# Базовый URL Generative Language API. По умолчанию
# https://generativelanguage.googleapis.com/v1beta/models
# (менять только при кастомном эндпоинте / шлюзе).
GEMINI_API_BASE=
# Макс. число одновременных запросов к Gemini (защита от 429 и OOM).
GEMINI_MAX_CONCURRENCY=8

# Хранение данных (SQLite; путь задаётся DB_PATH, Postgres не используется)
UPLOAD_DIR=./uploads

# PDF Generation
HTML2PDF_API_KEY=your_html2pdf_api_key_here

# Аналитика (PostHog; опционально - пусто = события не отправляются)
POSTHOG_API_KEY=

# Промокоды на Premium (через запятую; опционально)
PROMO_CODES=
PROMO_CODES_MONTHLY=

# Web App (Дашборд)
WEBAPP_URL=http://localhost:8080/dashboard
DASHBOARD_URL=http://localhost:8080/dashboard
